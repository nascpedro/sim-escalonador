  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #f3f5f7;
}
QWidget {
    color: #18222e;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 10pt;
}
QLabel {
    color: #18222e;
    background: transparent;
}
QFrame#cabecalhoFrame {
    background-color: #ffffff;
    border: 1px solid #cbd2da;
    border-radius: 6px;
}
QLabel#tituloJanelaLabel {
    font-size: 15pt;
    font-weight: 700;
    color: #18222e;
}
QLabel#subtituloJanelaLabel {
    font-size: 9.5pt;
    color: #566372;
}
QLabel#resumoMetaLabel {
    font-family: Consolas, &quot;Courier New&quot;, monospace;
    font-size: 9.5pt;
    color: #334354;
    background-color: #eef2f6;
    border: 1px solid #d5dde5;
    border-radius: 4px;
    padding: 6px 10px;
}
QTabWidget#abasPrincipais::pane {
    border: 1px solid #cbd2da;
    background-color: #ffffff;
    border-radius: 6px;
    top: -1px;
}
QTabBar::tab {
    background-color: #e9edf2;
    color: #566372;
    border: 1px solid #cbd2da;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 9px 20px;
    margin-right: 4px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #11665e;
    border-bottom: 3px solid #168276;
}
QFrame#barraControlesFrame {
    background-color: #fafbfc;
    border: 1px solid #e2e6eb;
    border-radius: 5px;
}
QFrame#painelGraficoFrame {
    background-color: #ffffff;
    border: 1px solid #e2e6eb;
    border-radius: 5px;
}
QWidget#graficoContainer {
    background-color: #f8fafc;
    border: 1px dashed #94a3b8;
    border-radius: 4px;
}
QLabel#graficoPlaceholderLabel {
    color: #475569;
    font-size: 10pt;
}
QFrame#inspecaoTarefaFrame {
    background-color: #fafbfc;
    border: 1px solid #e0e5ea;
    border-radius: 5px;
}
QFrame#rodapeStatusFrame {
    background-color: #f8fafc;
    border: 1px solid #dde3e9;
    border-radius: 5px;
}
QLabel#mensagemStatusLabel {
    color: #334354;
    font-size: 9.5pt;
}
QLabel#tituloGraficoLabel, QLabel#tituloInspecaoLabel, QLabel#tituloConfiguracaoLabel, QLabel#tituloLogLabel {
    font-size: 11.5pt;
    font-weight: 700;
    color: #18222e;
}
QLabel#subtituloGraficoLabel, QLabel#legendaGanttLabel, QLabel#notaInspecaoLabel {
    font-size: 9pt;
    color: #5c6b7a;
}
QLabel[objectName^=&quot;rotulo&quot;] {
    color: #566372;
}
QLabel[objectName^=&quot;valor&quot;] {
    color: #18222e;
    font-weight: 600;
}
QPushButton {
    background-color: #ffffff;
    color: #334354;
    border: 1px solid #ccd4dc;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #f0f4f8;
    border-color: #9fb0c0;
}
QPushButton:disabled {
    background-color: #f4f6f8;
    color: #9aa6b2;
    border-color: #dde3e9;
}
QPushButton#avancarButton, QPushButton#aplicarConfiguracaoButton {
    background-color: #14796f;
    color: #ffffff;
    border-color: #14796f;
}
QPushButton#avancarButton:hover, QPushButton#aplicarConfiguracaoButton:hover {
    background-color: #11665e;
}
QComboBox, QSpinBox, QLineEdit, QPlainTextEdit, QTableWidget {
    background-color: #ffffff;
    color: #18222e;
    border: 1px solid #cbd2da;
    border-radius: 4px;
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #f1f5f9;
    color: #475569;
    font-weight: 600;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #cbd2da;
    border-right: 1px solid #e2e8f0;
}</string>
